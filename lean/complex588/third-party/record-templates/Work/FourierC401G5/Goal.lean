namespace OAI

namespace PowerSaving
noncomputable section
open RAM RAM.Ty Filter Asymptotics

def decimalExponentC401G5 : ℝ := 1 - 10221076/(10^(10:ℕ))

def decimalTimeC401G5 (n : ℕ) : ℝ := (n:ℝ) * (Real.log (n:ℝ)) ^ decimalExponentC401G5

/-- Thm 1 (intro main) and decimal corollary estimates. -/
def TimeBoundsC401G5 (W : ℕ → ℕ) : Prop :=
  let W' := fun n : ℕ => (W n : ℝ)
  W' =O[atTop] paperTime ∧ W' =O[atTop] decimalTimeC401G5 ∧ W' =o[atTop] nlogn

def DFTGoalC401G5 : Prop := ∃ order solve W, DFTProgram order solve W ∧ TimeBoundsC401G5 W

def ConvGoalC401G5 : Prop := ∃ order solve W, ConvProgram order solve W ∧ TimeBoundsC401G5 W

end
