/-! Main results. Provide formula for the order besides the existential specification. -/
theorem transform_main_orderC401G5 : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsC401G5 W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipOneC401G5
  exact ⟨o,s,lunchC401G5 a b id,hp,Skies.time_boundC401G5 (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderC401G5 : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsC401G5 W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipBothC401G5
  have h (n : ℕ) : n ≤ stretchC401G5 n ∧ stretchC401G5 n ≤ 2*n := by unfold stretchC401G5; omega
  exact ⟨o,s,lunchC401G5 a b stretchC401G5,hp,Skies.time_boundC401G5 h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posC401G5 hn)).2⟩⟩

