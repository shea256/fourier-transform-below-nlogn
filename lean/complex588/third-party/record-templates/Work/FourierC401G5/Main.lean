lemma multiplier_rangeC401G5 : 1 < paperMultiplier ∧ paperMultiplier < paperM := by
  norm_num [paperMultiplier,paperM,paperDelta,paperW]

lemma theta_ltC401G5 : theta < 1 := by
  have h := multiplier_rangeC401G5
  have hg : 0<log paperM := Real.log_pos (lt_trans h.1 h.2)
  rw [theta,div_lt_iff₀ hg,one_mul]
  exact Real.log_lt_log (by linarith) h.2

lemma alpha_thetaC401G5 : alphaC401G5 < theta := by
  let d : ℝ := 10221077/(10:ℝ)^10
  have hp : 0<d := by dsimp [d]; norm_num
  have hm : 2 ≤ paperM := by norm_num [paperM]
  have hx : 0<paperMultiplier := lt_trans zero_lt_one multiplier_rangeC401G5.1
  have hu : 0<paperM := by linarith
  have h2 := (Real.log_le_log (by norm_num : 0 < (2:ℝ)) hm)
  have he := log2_minC401G5
  have hh : 0<log paperM := by linarith
  have hk := Real.log_le_sub_one_of_pos (show 0<paperM/paperMultiplier by positivity)
  rw [log_div hu.ne' hx.ne'] at hk
  have H : paperM/paperMultiplier-1 < d*(2/3) := by
    norm_num [d,paperM,paperMultiplier,paperW,paperDelta]
  rw [theta,lt_div_iff₀ hh]
  change (1-d)*log paperM < log paperMultiplier
  have H' := mul_le_mul_of_nonneg_left (he.trans h2) hp.le
  have hy := hk.trans_lt (lt_of_lt_of_le H H')
  rw [sub_mul,one_mul]
  linarith only [hy]

lemma decimal_rangeC401G5 : alphaC401G5 < decimalExponentC401G5 ∧ decimalExponentC401G5 < 1 := by
  norm_num [decimalExponentC401G5,alphaC401G5]

def speedC401G5 (v : ℝ) (n : ℕ) := (n:ℝ)*(TmC401G5 n)^v

lemma flight_littleC401G5 {v : ℝ} (h : alphaC401G5 < v) :
    flightC401G5 =o[atTop] speedC401G5 v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopC401G5.eventually_ge_atTop 1,dwarfC401G5 TtopC401G5 2
    (p:=v-alphaC401G5) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmC401G5 n := by linarith
  change ‖(n:ℝ)*TmC401G5 n^alphaC401G5*QmC401G5 n^2‖ ≤ c*‖(n:ℝ)*TmC401G5 n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ ((n:ℝ)*TmC401G5 n^alphaC401G5)*(c*TmC401G5 n^(v-alphaC401G5)) :=
      mul_le_mul_of_nonneg_left hh (by positivity)
    _ = c*((n:ℝ)*(TmC401G5 n^alphaC401G5*TmC401G5 n^(v-alphaC401G5))) := by ring
    _ = _ := by rw [← rpow_add he, show alphaC401G5 + (v-alphaC401G5)=v by ring] -- a+(v-a)

lemma speed_littleC401G5 {u v : ℝ} (h : u < v) :
    speedC401G5 u =o[atTop] speedC401G5 v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopC401G5.eventually_ge_atTop 1,dwarfC401G5 TtopC401G5 0
    (p:=v-u) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmC401G5 n := by linarith
  change ‖(n:ℝ)*TmC401G5 n^u‖ ≤ c*‖(n:ℝ)*TmC401G5 n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  have hh' : 1 ≤ c * TmC401G5 n^(v-u) := by simpa only [pow_zero] using hh
  calc
    _ = ((n:ℝ)*TmC401G5 n^u)*1 := by ring
    _ ≤ ((n:ℝ)*TmC401G5 n^u)*(c*TmC401G5 n^(v-u)) := mul_le_mul_of_nonneg_left hh' (by positivity)
    _ = c*((n:ℝ)*(TmC401G5 n^u*TmC401G5 n^(v-u))) := by ring
    _ = _ := by rw [← rpow_add he, show u+(v-u)=v by ring]

theorem decimal_littleC401G5 : decimalTimeC401G5 =o[atTop] nlogn := by
  have H := speed_littleC401G5 decimal_rangeC401G5.2
  have h : speedC401G5 1 = nlogn := funext fun n => by rw [speedC401G5,Real.rpow_one]; rfl
  rw [h] at H; exact H

lemma speed_paperC401G5 : speedC401G5 theta =O[atTop] paperTime := by
  rw [isBigO_iff]
  refine ⟨1,?_⟩
  filter_upwards [TtopC401G5.eventually_ge_atTop 1,QtopC401G5.eventually_ge_atTop 1] with n hn hh
  have he : 0<TmC401G5 n := by linarith
  have he' : 0<QmC401G5 n := by linarith
  change ‖(n:ℝ)*TmC401G5 n^theta‖ ≤ 1*‖(n:ℝ)*TmC401G5 n^theta*QmC401G5 n^(4-theta)‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity),one_mul]
  have hb := Real.one_le_rpow hh (show 0 ≤ 4-theta by linarith [theta_ltC401G5])
  exact le_mul_of_one_le_right (by positivity) hb

lemma time_boundC401G5 {N} (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (a b : RationC401G5) :
    TimeBoundsC401G5 (lunchC401G5 a b N) := by
  have H := lunch_bigC401G5 a b h
  have hp := H.trans_isLittleO (flight_littleC401G5 alpha_thetaC401G5)
  have hd := H.trans_isLittleO (flight_littleC401G5 decimal_rangeC401G5.1)
  have ht : (fun n => (lunchC401G5 a b N n:ℝ)) =O[atTop] decimalTimeC401G5 := hd.isBigO
  exact ⟨hp.isBigO.trans speed_paperC401G5,ht,ht.trans_isLittleO decimal_littleC401G5⟩

