lemma multiplier_rangeC588 : 1 < paperMultiplier ∧ paperMultiplier < paperM := by
  norm_num [paperMultiplier,paperM,paperDelta,paperW]

lemma theta_ltC588 : theta < 1 := by
  have h := multiplier_rangeC588
  have hg : 0<log paperM := Real.log_pos (lt_trans h.1 h.2)
  rw [theta,div_lt_iff₀ hg,one_mul]
  exact Real.log_lt_log (by linarith) h.2

lemma alpha_thetaC588 : alphaC588 < theta := by
  let d : ℝ := 12331686/(10:ℝ)^10
  have hp : 0<d := by dsimp [d]; norm_num
  have hm : 2 ≤ paperM := by norm_num [paperM]
  have hx : 0<paperMultiplier := lt_trans zero_lt_one multiplier_rangeC588.1
  have hu : 0<paperM := by linarith
  have h2 := (Real.log_le_log (by norm_num : 0 < (2:ℝ)) hm)
  have he := log2_minC588
  have hh : 0<log paperM := by linarith
  have hk := Real.log_le_sub_one_of_pos (show 0<paperM/paperMultiplier by positivity)
  rw [log_div hu.ne' hx.ne'] at hk
  have H : paperM/paperMultiplier-1 < d*(2/3) := by
    norm_num [d,paperM,paperMultiplier,paperW,paperDelta]
  rw [theta,lt_div_iff₀ hh]
  change (1-d)*log paperM < log paperMultiplier
  have H' := mul_le_mul_of_nonneg_left (he.trans h2) hp.le
  have hy := hk.trans_lt (lt_of_lt_of_le H H')
  rw [sub_mul,one_mul]
  linarith only [hy]

lemma decimal_rangeC588 : alphaC588 < decimalExponentC588 ∧ decimalExponentC588 < 1 := by
  norm_num [decimalExponentC588,alphaC588]

def speedC588 (v : ℝ) (n : ℕ) := (n:ℝ)*(TmC588 n)^v

lemma flight_littleC588 {v : ℝ} (h : alphaC588 < v) :
    flightC588 =o[atTop] speedC588 v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopC588.eventually_ge_atTop 1,dwarfC588 TtopC588 2
    (p:=v-alphaC588) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmC588 n := by linarith
  change ‖(n:ℝ)*TmC588 n^alphaC588*QmC588 n^2‖ ≤ c*‖(n:ℝ)*TmC588 n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ ((n:ℝ)*TmC588 n^alphaC588)*(c*TmC588 n^(v-alphaC588)) :=
      mul_le_mul_of_nonneg_left hh (by positivity)
    _ = c*((n:ℝ)*(TmC588 n^alphaC588*TmC588 n^(v-alphaC588))) := by ring
    _ = _ := by rw [← rpow_add he, show alphaC588 + (v-alphaC588)=v by ring] -- a+(v-a)

lemma speed_littleC588 {u v : ℝ} (h : u < v) :
    speedC588 u =o[atTop] speedC588 v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopC588.eventually_ge_atTop 1,dwarfC588 TtopC588 0
    (p:=v-u) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmC588 n := by linarith
  change ‖(n:ℝ)*TmC588 n^u‖ ≤ c*‖(n:ℝ)*TmC588 n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  have hh' : 1 ≤ c * TmC588 n^(v-u) := by simpa only [pow_zero] using hh
  calc
    _ = ((n:ℝ)*TmC588 n^u)*1 := by ring
    _ ≤ ((n:ℝ)*TmC588 n^u)*(c*TmC588 n^(v-u)) := mul_le_mul_of_nonneg_left hh' (by positivity)
    _ = c*((n:ℝ)*(TmC588 n^u*TmC588 n^(v-u))) := by ring
    _ = _ := by rw [← rpow_add he, show u+(v-u)=v by ring]

theorem decimal_littleC588 : decimalTimeC588 =o[atTop] nlogn := by
  have H := speed_littleC588 decimal_rangeC588.2
  have h : speedC588 1 = nlogn := funext fun n => by rw [speedC588,Real.rpow_one]; rfl
  rw [h] at H; exact H

lemma speed_paperC588 : speedC588 theta =O[atTop] paperTime := by
  rw [isBigO_iff]
  refine ⟨1,?_⟩
  filter_upwards [TtopC588.eventually_ge_atTop 1,QtopC588.eventually_ge_atTop 1] with n hn hh
  have he : 0<TmC588 n := by linarith
  have he' : 0<QmC588 n := by linarith
  change ‖(n:ℝ)*TmC588 n^theta‖ ≤ 1*‖(n:ℝ)*TmC588 n^theta*QmC588 n^(4-theta)‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity),one_mul]
  have hb := Real.one_le_rpow hh (show 0 ≤ 4-theta by linarith [theta_ltC588])
  exact le_mul_of_one_le_right (by positivity) hb

lemma time_boundC588 {N} (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (a b : RationC588) :
    TimeBoundsC588 (lunchC588 a b N) := by
  have H := lunch_bigC588 a b h
  have hp := H.trans_isLittleO (flight_littleC588 alpha_thetaC588)
  have hd := H.trans_isLittleO (flight_littleC588 decimal_rangeC588.1)
  have ht : (fun n => (lunchC588 a b N n:ℝ)) =O[atTop] decimalTimeC588 := hd.isBigO
  exact ⟨hp.isBigO.trans speed_paperC588,ht,ht.trans_isLittleO decimal_littleC588⟩

