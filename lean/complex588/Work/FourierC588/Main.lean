theorem transform_mainC588 : DFTGoalC588 :=
  let ⟨o,s,W,h,g,_⟩ := transform_main_orderC588
  ⟨o,s,W,h,g⟩

/-- **Convolution of every length with the same bounds** (OpenAI's `convolution_main`, same change). -/
theorem convolution_mainC588 : ConvGoalC588 :=
  let ⟨o,s,W,h,g,_⟩ := convolution_main_orderC588
