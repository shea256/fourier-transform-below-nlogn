/-! Main results. Provide formula for the order besides the existential specification. -/
theorem transform_main_orderC588 : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsC588 W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipOneC588
  exact ⟨o,s,lunchC588 a b id,hp,Skies.time_boundC588 (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderC588 : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsC588 W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipBothC588
  have h (n : ℕ) : n ≤ stretchC588 n ∧ stretchC588 n ≤ 2*n := by unfold stretchC588; omega
  exact ⟨o,s,lunchC588 a b stretchC588,hp,Skies.time_boundC588 h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posC588 hn)).2⟩⟩

/-- **The discrete Fourier transform of every length in `O(n (log n)^(1 - 12331685/10^10))`.**
OpenAI's `transform_main` (one fixed program, OpenAI's own `DFTProgram`, `paperTime` and `nlogn`)
with the decimal exponent `1 - 1/10^13` replaced by `decimalExponentC588 = 1 - 12331685/10^10`
(Work/FourierC588/Goal.lean). Sibling of the Walsh-Hadamard theorem `wht_main_block_C588x`: both
