def decimalExponentC588 : ℝ := 1 - 12331685/(10^(10:ℕ))

def decimalTimeC588 (n : ℕ) : ℝ := (n:ℝ) * (Real.log (n:ℝ)) ^ decimalExponentC588

/-- Thm 1 (intro main) and decimal corollary estimates. -/
def TimeBoundsC588 (W : ℕ → ℕ) : Prop :=
  let W' := fun n : ℕ => (W n : ℝ)
  W' =O[atTop] paperTime ∧ W' =O[atTop] decimalTimeC588 ∧ W' =o[atTop] nlogn

def DFTGoalC588 : Prop := ∃ order solve W, DFTProgram order solve W ∧ TimeBoundsC588 W

def ConvGoalC588 : Prop := ∃ order solve W, ConvProgram order solve W ∧ TimeBoundsC588 W

