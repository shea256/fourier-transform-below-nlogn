import Work.GCert.Chain.End
import Work.GCert.Data.Glue
import Work.GCert.Data.R11Cert
import Work.GCert.Data.InstB2GR11

/-!
# (key: gx-data) Bridged word B_2 with the gcert/1 circuit `R11` (h = 22, m = 110): final theorems over a scalar half
GENERATED by checks/wht26/gx-data/py/gxrate.py.  No `sorry`.
`GX.wht_of_halves` (gx-chain) on the label half `GXD.R11.valid` (kernel checks of `Work/GCert/Data/Gen/R11*`), its
price `GXD.R11.lab_price`, the unit list `BlockAccounting.blocksB2GR11` (`W = 15562` live roles) and the rate facts
`fold_B2GR11` (`1 - 71508/10^8`), `fold_B2GR11x` (`1 - 7150885/10^10`).
The ONLY hypothesis left is the scalar half: `S : GX.Scal (Fin 1320) (Fin 10282) C` whose gate matrices are the ordered
products of the adds of `raw` (`hMA .. hMBi`), with `22` copies read from the retained registers (`reg`, `hCc`, `hreg`, `hC`);
`wht_B2GR11_of_ids`, `wht_B2GR11x_of_ids`: the same from the five identities `hAi hBi hx hy hid` of gx-scalar's matrices
`GS.MA GS.MAi GS.MB GS.MBi GS.Jrm GS.Ccm` of `raw` (the fields of the planned `GS.ScalOK`).
-/

namespace OAI
namespace PowerSaving
namespace WHT
open BlockWHT

variable {C : Type} [Fintype C] [DecidableEq C] (S : GX.Scal (Fin GXD.R11.raw.v) (Fin GXD.R11.raw.R) C)
  {emb : CR.L3 (Fin GXD.R11.raw.v) (Fin GXD.R11.raw.R) → Nat} {un : Nat → CR.L3 (Fin GXD.R11.raw.v) (Fin GXD.R11.raw.R)}
  (cf : GXD.Co → SSC.Coef)

/-- **Walsh-Hadamard transform, whole-block recursion on the bridged word B_2 with the gcert/1 circuit `R11`**,
over any scalar half of `GXD.R11.raw`: the statement `WHTGoal` of `WHTCheck/Challenge.lean` with `1 - 2/10^11`
replaced by `1 - 71508/10^8`. -/
theorem wht_B2GR11_of_scal (Ro : GLab.Roles GXD.R11.raw.v GXD.R11.raw.R emb un)
    (hMA : S.MA = SSC.matP un (GLab.mic cf (GXD.R11.raw.gatesA.flatMap GXD.Gate.adds)))
    (hMAi : S.MAi = SSC.matPinv un (GLab.mic cf (GXD.R11.raw.gatesA.flatMap GXD.Gate.adds)))
    (hMB : S.MB = SSC.matP un (GLab.mic cf (GXD.R11.raw.gatesB.flatMap GXD.Gate.adds)))
    (hMBi : S.MBi = SSC.matPinv un (GLab.mic cf (GXD.R11.raw.gatesB.flatMap GXD.Gate.adds)))
    (reg : C → Nat) (hCc : ∀ k (q : Fin GXD.R11.raw.R), S.Cc k q ≠ 0 → reg k = 2 * GXD.R11.raw.v + q.val)
    (hreg : ∀ k, reg k ∈ GXD.R11.raw.ret.map Prod.fst) (hC : Fintype.card C = 22) :
    ∃ solve W, WHTProgram solve W ∧ BlockWHT.WHTTimeBoundsAt (1 - 71508/(10:ℝ)^8) W :=
  GX.wht_of_halves S (GXD.R11.valid.lab S Ro cf hMA hMAi hMB hMBi reg hCc hreg)
    (by rw [Fintype.card_fin]; decide) 110 15562 (by rw [Fintype.card_fin]; rfl)
    (by rw [Fintype.card_fin, Fintype.card_fin]; rfl) (by norm_num) BlockAccounting.blocksB2GR11
    (fun φ => by
      rw [GXD.R11.lab_price S Ro cf hMA hMAi hMB hMBi reg hCc hreg hC φ, Fintype.card_fin, Fintype.card_fin]
      exact BridgeRate.B2GR11.unit_cost φ)
    13 (1 - 71508/(10:ℝ)^8) (by norm_num) (by norm_num) BlockAccounting.fold_B2GR11

/-- the same from the FIVE scalar identities of gx-scalar's matrices of `GXD.R11.raw` (`Work/GCert/Data/Glue.lean`) -/
theorem wht_B2GR11_of_ids (hv : 0 < GXD.R11.raw.v)
    (hAi : GS.MAi GXD.R11.raw hv * GS.MA GXD.R11.raw hv = 1) (hBi : GS.MBi GXD.R11.raw hv * GS.MB GXD.R11.raw hv = 1)
    (hx : ∀ (t : Fin GXD.R11.raw.v) (j : GS.Rl GXD.R11.raw), (GS.MB GXD.R11.raw hv * CR.scatM (GS.Jrm GXD.R11.raw * GS.Ccm GXD.R11.raw)
      * GS.MA GXD.R11.raw hv) (CR.lX t) j = if CR.lX t = j then 1 else 0)
    (hy : ∀ (i : GS.Rl GXD.R11.raw) (t : Fin GXD.R11.raw.v), (GS.MB GXD.R11.raw hv * CR.scatM (GS.Jrm GXD.R11.raw * GS.Ccm GXD.R11.raw)
      * GS.MA GXD.R11.raw hv) i (CR.lY t) = if i = CR.lY t then 1 else 0)
    (hid : ∀ S t : Fin GXD.R11.raw.v, (GS.MB GXD.R11.raw hv * CR.scatM (GS.Jrm GXD.R11.raw * GS.Ccm GXD.R11.raw)
      * GS.MA GXD.R11.raw hv) (CR.lY S) (CR.lX t) = if S = t then 1 else 0) :
    ∃ solve W, WHTProgram solve W ∧ BlockWHT.WHTTimeBoundsAt (1 - 71508/(10:ℝ)^8) W :=
  wht_B2GR11_of_scal (GXD.scalOf GXD.R11.raw hv hAi hBi hx hy hid) GS.toCoef (GXD.roles GXD.R11.raw hv)
    (GXD.scalOf_MA _ hv hAi hBi hx hy hid) (GXD.scalOf_MAi _ hv hAi hBi hx hy hid)
    (GXD.scalOf_MB _ hv hAi hBi hx hy hid) (GXD.scalOf_MBi _ hv hAi hBi hx hy hid)
    (GXD.reg GXD.R11.raw) (GXD.reg_slot GXD.R11.raw hv hAi hBi hx hy hid) (GXD.reg_mem GXD.R11.raw)
    (by rw [Fintype.card_fin]; decide)

/-- **Walsh-Hadamard transform, whole-block recursion on the bridged word B_2 with the gcert/1 circuit `R11`**,
over any scalar half of `GXD.R11.raw`: the statement `WHTGoal` of `WHTCheck/Challenge.lean` with `1 - 2/10^11`
replaced by `1 - 7150885/10^10`. -/
theorem wht_B2GR11x_of_scal (Ro : GLab.Roles GXD.R11.raw.v GXD.R11.raw.R emb un)
    (hMA : S.MA = SSC.matP un (GLab.mic cf (GXD.R11.raw.gatesA.flatMap GXD.Gate.adds)))
    (hMAi : S.MAi = SSC.matPinv un (GLab.mic cf (GXD.R11.raw.gatesA.flatMap GXD.Gate.adds)))
    (hMB : S.MB = SSC.matP un (GLab.mic cf (GXD.R11.raw.gatesB.flatMap GXD.Gate.adds)))
    (hMBi : S.MBi = SSC.matPinv un (GLab.mic cf (GXD.R11.raw.gatesB.flatMap GXD.Gate.adds)))
    (reg : C → Nat) (hCc : ∀ k (q : Fin GXD.R11.raw.R), S.Cc k q ≠ 0 → reg k = 2 * GXD.R11.raw.v + q.val)
    (hreg : ∀ k, reg k ∈ GXD.R11.raw.ret.map Prod.fst) (hC : Fintype.card C = 22) :
    ∃ solve W, WHTProgram solve W ∧ BlockWHT.WHTTimeBoundsAt (1 - 7150885/(10:ℝ)^10) W :=
  GX.wht_of_halves S (GXD.R11.valid.lab S Ro cf hMA hMAi hMB hMBi reg hCc hreg)
    (by rw [Fintype.card_fin]; decide) 110 15562 (by rw [Fintype.card_fin]; rfl)
    (by rw [Fintype.card_fin, Fintype.card_fin]; rfl) (by norm_num) BlockAccounting.blocksB2GR11x
    (fun φ => by
      rw [GXD.R11.lab_price S Ro cf hMA hMAi hMB hMBi reg hCc hreg hC φ, Fintype.card_fin, Fintype.card_fin]
      exact BridgeRate.B2GR11.unit_cost_x φ)
    40 (1 - 7150885/(10:ℝ)^10) (by norm_num) (by norm_num) BlockAccounting.fold_B2GR11x

/-- the same from the FIVE scalar identities of gx-scalar's matrices of `GXD.R11.raw` (`Work/GCert/Data/Glue.lean`) -/
theorem wht_B2GR11x_of_ids (hv : 0 < GXD.R11.raw.v)
    (hAi : GS.MAi GXD.R11.raw hv * GS.MA GXD.R11.raw hv = 1) (hBi : GS.MBi GXD.R11.raw hv * GS.MB GXD.R11.raw hv = 1)
    (hx : ∀ (t : Fin GXD.R11.raw.v) (j : GS.Rl GXD.R11.raw), (GS.MB GXD.R11.raw hv * CR.scatM (GS.Jrm GXD.R11.raw * GS.Ccm GXD.R11.raw)
      * GS.MA GXD.R11.raw hv) (CR.lX t) j = if CR.lX t = j then 1 else 0)
    (hy : ∀ (i : GS.Rl GXD.R11.raw) (t : Fin GXD.R11.raw.v), (GS.MB GXD.R11.raw hv * CR.scatM (GS.Jrm GXD.R11.raw * GS.Ccm GXD.R11.raw)
      * GS.MA GXD.R11.raw hv) i (CR.lY t) = if i = CR.lY t then 1 else 0)
    (hid : ∀ S t : Fin GXD.R11.raw.v, (GS.MB GXD.R11.raw hv * CR.scatM (GS.Jrm GXD.R11.raw * GS.Ccm GXD.R11.raw)
      * GS.MA GXD.R11.raw hv) (CR.lY S) (CR.lX t) = if S = t then 1 else 0) :
    ∃ solve W, WHTProgram solve W ∧ BlockWHT.WHTTimeBoundsAt (1 - 7150885/(10:ℝ)^10) W :=
  wht_B2GR11x_of_scal (GXD.scalOf GXD.R11.raw hv hAi hBi hx hy hid) GS.toCoef (GXD.roles GXD.R11.raw hv)
    (GXD.scalOf_MA _ hv hAi hBi hx hy hid) (GXD.scalOf_MAi _ hv hAi hBi hx hy hid)
    (GXD.scalOf_MB _ hv hAi hBi hx hy hid) (GXD.scalOf_MBi _ hv hAi hBi hx hy hid)
    (GXD.reg GXD.R11.raw) (GXD.reg_slot GXD.R11.raw hv hAi hBi hx hy hid) (GXD.reg_mem GXD.R11.raw)
    (by rw [Fintype.card_fin]; decide)

end WHT
