namespace OAI

/-!
Exact uniform Fourier transforms and convolution.

The construction formalizes the exact arithmetic algorithms of
*An explicit power saving for the exact discrete Fourier transform* (OpenAI).
The finite phase network originates in the complex construction of
*Integer multiplication below n log n*.

`transform_mainX` and `convolution_mainX` give fixed finite RAM programs, including
preparation and index work, polynomial storage bounds, and a canonical root whose
order is computed from the input length. Each includes the paper exponent, decimal
power saving, and little-o bound. The `_order` variants also specify the root order.

The implementation uses a smaller concrete tensor network (32 binary coordinates
per factor, 4060 triples, and a `2^50` role envelope) with a stronger saving that
implies the stated paper constants. The general rational-algebra extraction,
symbolic certificate search, circuit printer, and bounded-printer uniformization
from the synthesis appendix are outside this formalization.
-/
namespace PowerSaving
open RAM Bench Selection Filter Asymptotics Real
noncomputable section
namespace Skies

lemma multiplier_rangeX : 1 < paperMultiplier ∧ paperMultiplier < paperM := by
  norm_num [paperMultiplier,paperM,paperDelta,paperW]

lemma theta_ltX : theta < 1 := by
  have h := multiplier_rangeX
  have hg : 0<log paperM := Real.log_pos (lt_trans h.1 h.2)
  rw [theta,div_lt_iff₀ hg,one_mul]
  exact Real.log_lt_log (by linarith) h.2

lemma alpha_thetaX : alphaX < theta := by
  let d : ℝ := 7150885/(10:ℝ)^10
  have hp : 0<d := by dsimp [d]; norm_num
  have hm : 2 ≤ paperM := by norm_num [paperM]
  have hx : 0<paperMultiplier := lt_trans zero_lt_one multiplier_rangeX.1
  have hu : 0<paperM := by linarith
  have h2 := (Real.log_le_log (by norm_num : 0 < (2:ℝ)) hm)
  have he := log2_minX
  have hh : 0<log paperM := by linarith
  have hk := Real.log_le_sub_one_of_pos (show 0<paperM/paperMultiplier by positivity)
  rw [log_div hu.ne' hx.ne'] at hk
  have H : paperM/paperMultiplier-1 < d*(2/3) := by
    norm_num [d,paperM,paperMultiplier,paperW,paperDelta]
  rw [theta,lt_div_iff₀ hh]
  change (1-d)*log paperM < log paperMultiplier
  have H' := mul_le_mul_of_nonneg_left (he.trans h2) hp.le
  have hy := hk.trans_lt (lt_of_lt_of_le H H')
  rw [sub_mul,one_mul]
  linarith only [hy]

lemma decimal_rangeX : alphaX < decimalExponentX ∧ decimalExponentX < 1 := by
  norm_num [decimalExponentX,alphaX]

def speedX (v : ℝ) (n : ℕ) := (n:ℝ)*(TmX n)^v

lemma flight_littleX {v : ℝ} (h : alphaX < v) :
    flightX =o[atTop] speedX v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopX.eventually_ge_atTop 1,dwarfX TtopX 2
    (p:=v-alphaX) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmX n := by linarith
  change ‖(n:ℝ)*TmX n^alphaX*QmX n^2‖ ≤ c*‖(n:ℝ)*TmX n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ ((n:ℝ)*TmX n^alphaX)*(c*TmX n^(v-alphaX)) :=
      mul_le_mul_of_nonneg_left hh (by positivity)
    _ = c*((n:ℝ)*(TmX n^alphaX*TmX n^(v-alphaX))) := by ring
    _ = _ := by rw [← rpow_add he, show alphaX + (v-alphaX)=v by ring] -- a+(v-a)

lemma speed_littleX {u v : ℝ} (h : u < v) :
    speedX u =o[atTop] speedX v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopX.eventually_ge_atTop 1,dwarfX TtopX 0
    (p:=v-u) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmX n := by linarith
  change ‖(n:ℝ)*TmX n^u‖ ≤ c*‖(n:ℝ)*TmX n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  have hh' : 1 ≤ c * TmX n^(v-u) := by simpa only [pow_zero] using hh
  calc
    _ = ((n:ℝ)*TmX n^u)*1 := by ring
    _ ≤ ((n:ℝ)*TmX n^u)*(c*TmX n^(v-u)) := mul_le_mul_of_nonneg_left hh' (by positivity)
    _ = c*((n:ℝ)*(TmX n^u*TmX n^(v-u))) := by ring
    _ = _ := by rw [← rpow_add he, show u+(v-u)=v by ring]

theorem decimal_littleX : decimalTimeX =o[atTop] nlogn := by
  have H := speed_littleX decimal_rangeX.2
  have h : speedX 1 = nlogn := funext fun n => by rw [speedX,Real.rpow_one]; rfl
  rw [h] at H; exact H

lemma speed_paperX : speedX theta =O[atTop] paperTime := by
  rw [isBigO_iff]
  refine ⟨1,?_⟩
  filter_upwards [TtopX.eventually_ge_atTop 1,QtopX.eventually_ge_atTop 1] with n hn hh
  have he : 0<TmX n := by linarith
  have he' : 0<QmX n := by linarith
  change ‖(n:ℝ)*TmX n^theta‖ ≤ 1*‖(n:ℝ)*TmX n^theta*QmX n^(4-theta)‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity),one_mul]
  have hb := Real.one_le_rpow hh (show 0 ≤ 4-theta by linarith [theta_ltX])
  exact le_mul_of_one_le_right (by positivity) hb

lemma time_boundX {N} (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (a b : RationX) :
    TimeBoundsX (lunchX a b N) := by
  have H := lunch_bigX a b h
  have hp := H.trans_isLittleO (flight_littleX alpha_thetaX)
  have hd := H.trans_isLittleO (flight_littleX decimal_rangeX.1)
  have ht : (fun n => (lunchX a b N n:ℝ)) =O[atTop] decimalTimeX := hd.isBigO
  exact ⟨hp.isBigO.trans speed_paperX,ht,ht.trans_isLittleO decimal_littleX⟩

end Skies

/-! Main results. Provide formula for the order besides the existential specification. -/
theorem transform_main_orderX : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsX W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipOneX
  exact ⟨o,s,lunchX a b id,hp,Skies.time_boundX (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderX : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsX W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipBothX
  have h (n : ℕ) : n ≤ stretchX n ∧ stretchX n ≤ 2*n := by unfold stretchX; omega
  exact ⟨o,s,lunchX a b stretchX,hp,Skies.time_boundX h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posX hn)).2⟩⟩

/-- **The discrete Fourier transform of every length in `O(n (log n)^(1 - 6700000/10^10))`.**
OpenAI's `transform_main` (one fixed program, OpenAI's own `DFTProgram`, `paperTime` and `nlogn`)
with the decimal exponent `1 - 1/10^13` replaced by `decimalExponentX = 1 - 6700000/10^10`
(Work/FourierR11/Goal.lean). Sibling of the Walsh-Hadamard theorem `wht_main_block_B2GR11x`: both
follow from one kernel program, `RAM.hillsX_program` (Work/FourierR11/Seam.lean). -/
theorem transform_mainX : DFTGoalX :=
  let ⟨o,s,W,h,g,_⟩ := transform_main_orderX
  ⟨o,s,W,h,g⟩

/-- **Convolution of every length with the same bounds** (OpenAI's `convolution_main`, same change). -/
theorem convolution_mainX : ConvGoalX :=
  let ⟨o,s,W,h,g,_⟩ := convolution_main_orderX
  ⟨o,s,W,h,g⟩

lemma matrix_definitionX (n : ℕ) (x : Vec n) : dft n x = Matrix.mulVec (dftMatrix n) x :=
  rfl

