lemma fairwind_smallX (N : ι→ℕ) (hn : ∀ i,0<N i) (d : ℕ) :
    Small N fun i => fairwindX d (N i) := by
  have H := Small.self N
  have hX i := barge_spec (N i) (hn i)
  have h4 := (Small.const _ 4).mul H
  have hu := h4.mono (fun (i : ι) => stack_le (N i) (hn i))
  have hk : Small N fun i => harvestN (N i) :=
    (((Small.const _ 16).mul (hu.add (Small.const _ 4))).pow 2)
  have hh := ((Small.const _ 8).mul hk).mono
    (fun i => Nat.lt_two_pow_self.le.trans (orderE_small (N i)))
  have hi := ((((Small.const _ 20000000).mul ((hh.add (Small.const _ 1)).pow 2)).add
    (Small.const _ 7))).mono (fun i => score_le (orderE (N i)))
  have hp : Small N fun i => hillsX (barge (N i)).l :=
    (hu.add (Small.const _ 1)).mono fun i => (hillsX_le _).trans
      (Nat.add_le_add_right (hX i).count _)
  have hj := (hi.add (Small.const _ 1)).mul
    ((h4.mono fun i => (hX i).upper.le).mul hp)
  have hl := H.add hj |>.add ((hu.add (Small.const _ 2)).pow d)
  exact hl.add (((H.add (Small.const _ 2)).pow d).mono fun i => by split <;> omega)

-- package extracted charges
abbrev SizesX := {n : ℕ // 0<n}
abbrev entryX : SizesX→ℕ := Subtype.val

structure RationX where
  d : ℕ
  c : ℕ
  p : ℕ
def calorieX (a : RationX) (n : ℕ) := a.c*(fairwindX a.d n+1)

lemma BreezyX.ration {x : ι→T t} (h : b.BreezyX n t x) :
    ∃ (s : Prog m b.tray t) (a : RationX), ∀ i,
      (run s (b.env i)).OK (x i) (calorieX a (n i)) ((b.size i+2)^a.p) := by
  obtain ⟨d,hd⟩ := h
  obtain ⟨s,c,p,hc⟩ := Can.unfold_bound hd
  exact ⟨s,⟨d,c,p⟩,hc⟩

def lunchX (a b : RationX) (N : ℕ→ℕ) (n : ℕ) :=
  calorieX a (N n)+1+calorieX b (N n)

lemma storehouseX (N : ℕ→ℕ) (h : ∀ n,0<n → 0<N n) (g : Small entryX (fun i => N (entryX i)))
    (a b : RationX) : ∃ c : ℕ, ∀ n : ℕ, 0<n →
    let cap := (n+2)^c
    lunchX a b N n + 10*(n+2) ≤ cap ∧ (n+2)^a.p ≤ cap ∧ (n+2)^b.p ≤ cap ∧
    receipt (N n) ≤ cap := by
  let M i := N (entryX i)
  have H (a : RationX) : Small entryX (fun i => calorieX a (M i)) :=
    (Small.const _ a.c).mul (((fairwind_smallX M (fun i => h _ i.property) a.d).trans g).add
      (Small.const _ 1))
  have hu := (Small.self entryX).add (Small.const _ 2)
  have hh := (Small.const _ 10).mul hu
  have hp := ((Small.const _ 8).mul (g.pow 3)).mono
    (fun i => (receipt_bound _ (h _ i.property)).2.le)
  have ht := ((((H a).add (Small.const _ 1)).add (H b)).add hh)
  obtain ⟨c,hc⟩ := (((ht.max (hu.pow a.p)).max (hu.pow b.p)).max hp)
  refine ⟨c,fun n hn => ?_⟩
  specialize hc (⟨n,hn⟩:SizesX)
  have hx :
      max (max (max (lunchX a b N n + 10*(n+2)) ((n+2)^a.p)) ((n+2)^b.p)) (receipt (N n)) ≤
        (n+2)^c := hc
  have h1 := max_le_iff.mp hx
  have h2 := max_le_iff.mp h1.1
  have h3 := max_le_iff.mp h2.1
  exact ⟨h3.1,h3.2,h2.2,h1.2⟩

-- order environments
def onlyLengthX : Bench false SizesX := ⟨entryX,w,entryX⟩
lemma onlyLength_numX : onlyLengthX.Nick entryX := ⟨Can.id,Small.self _⟩

lemma orders1X : ∃ (s : Prog false w w) (a : RationX), ∀ n,0<n →
    (run s n).OK (receipt n) (calorieX a n) ((n+2)^a.p) := by
  obtain ⟨s,a,ha⟩ := (onlyLength_numX.landOrderX (fun i => i.property)).ration
  exact ⟨s,a,fun i hi => ha ⟨i,hi⟩⟩
lemma orders2X : ∃ (s : Prog false w w) (a : RationX), ∀ n,0<n →
    (run s n).OK (receipt (stretchX n)) (calorieX a (stretchX n)) ((n+2)^a.p) := by
  have H : onlyLengthX.Nick fun i => stretchX (entryX i) :=
    ((Nick.wc 2).mul onlyLength_numX).sub (Nick.wc 1)
  obtain ⟨s,a,ha⟩ := (H.landOrderX (fun i => stretch_posX i.property)).ration
  exact ⟨s,a,fun i hi => ha ⟨i,hi⟩⟩

def towerOneX : Bench false (SizesX×Line) :=
  ⟨fun i => entryX i.1,dftInKind,fun i =>
    (entryX i.1, root (receipt (entryX i.1)),Tape.tab (entryX i.1) i.2)⟩

lemma executeOneX : ∃ (s : Prog false dftInKind dftOutKind) (a : RationX),
    ∀ (n : ℕ),0<n → ∀ x : Vec n,
    (run s (n, root (receipt n), (⟨n,x⟩ : Tape ℂ))).OK
      (⟨n, dft n x⟩ : Tape ℂ) (calorieX a n) ((n+2)^a.p) := by
  let K := towerOneX
  have ht : K.Moves (fun _ => 0) dftInKind K.env := envNow K
  let n (i : SizesX × Line) := entryX i.1
  have hk : K.Nick n := ⟨ht.fst,Small.self _⟩
  have H := hk.landX (fun i => i.1.property) (ht.snd.fst) false (x:=Prod.snd) (cl:=Paint.left)
    (ht.snd.snd)
  obtain ⟨s,a,ha⟩ := H.ration
  refine ⟨s,a,fun n hn x => ?_⟩
  specialize ha ((⟨n,hn⟩:SizesX),extendLine x)
  change (run s (n,root (receipt n),(⟨n,front n (extendLine x)⟩:Tape ℂ))).OK
    (⟨n,front n (freq n (pr false n) (extendLine x))⟩ : Tape ℂ) _ _ at ha
  rw [← dft_front n,front_exact] at ha
  exact ha

def towerBothX : Bench true (SizesX×Line×Line) :=
  ⟨fun i => entryX i.1,convInKind,fun i =>
    (entryX i.1, root (receipt (stretchX (entryX i.1))),Tape.tab (entryX i.1) i.2.1,
      Tape.tab (entryX i.1) i.2.2)⟩

lemma executeBothX : ∃ (s : Prog true convInKind convOutKind) (a : RationX),
    ∀ (n : ℕ),0<n → ∀ x y : Vec n,
    (run s (n, root (receipt (stretchX n)), (⟨n,x⟩ : Tape ℂ),(⟨n,y⟩ : Tape ℂ))).OK
      (⟨stretchX n, conv n x y⟩ : Tape ℂ) (calorieX a (stretchX n)) ((n+2)^a.p) := by
  let K := towerBothX
  have ht : K.Moves (fun _ => 0) convInKind K.env := envNow K
  let n (i : SizesX × Line×Line) := entryX i.1
  have hk : K.Nick n := ⟨ht.fst,Small.self _⟩
  have H := fusingX hk (fun i => i.1.property) (x:=fun i => i.2.1) (y:=fun i => i.2.2)
    ht.snd.snd.fst ht.snd.snd.snd ht.snd.fst
  obtain ⟨s,a,ha⟩ := H.ration
  refine ⟨s,a,fun n hn x y => ?_⟩
  specialize ha ((⟨n,hn⟩:SizesX),extendLine x,extendLine y)
  change (run s (n,root (receipt (stretchX n)),
    (⟨n,front n (extendLine x)⟩:Tape ℂ),(⟨n,front n (extendLine y)⟩:Tape ℂ))).OK
    (⟨2*n-1,front (2*n-1)
      (cyclic (2*n-1) (padline n (extendLine y)) (padline n (extendLine x)))⟩ : Tape ℂ) _ _ at ha
  rw [cyclic_pad_front,front_exact,front_exact] at ha
  exact ha

theorem flagshipOneX : ∃ order solve a b,
    DFTProgram order solve (lunchX a b id) ∧
    ∀ n, 0<n → (run order n).val = receipt n := by
  obtain ⟨o,a,ho⟩ := orders1X
  obtain ⟨s,b,hs⟩ := executeOneX
  obtain ⟨c,hc⟩ := storehouseX id (fun _ h => h) (Small.self entryX) a b
  refine ⟨o,s,a,b,⟨c,fun n hn => ?_⟩,fun n hn => (ho n hn).result⟩
  obtain ⟨hu,hA,hB,hR⟩ := hc n hn
  have H := ho n hn
  have HH := receipt_bound n hn
  have he := H.result
  refine ⟨hu,H.bound.trans hA,H.valid,he.symm ▸ HH.1,he.symm ▸ ?_,he.symm ▸ hR,fun x => ?_⟩
  · exact HH.2.trans_le (by omega)
  dsimp only
  rw [he]
  have hj := hs n hn x
  exact ⟨hj.valid,hj.bound.trans hB,add_le_add (add_le_add_left H.time 1) hj.time,hj.result⟩

theorem flagshipBothX : ∃ order solve a b,
    ConvProgram order solve (lunchX a b stretchX) ∧
    ∀ n, 0<n → (run order n).val = receipt (stretchX n) := by
  obtain ⟨o,a,ho⟩ := orders2X
  obtain ⟨s,b,hs⟩ := executeBothX
  obtain ⟨c,hc⟩ := storehouseX stretchX (fun _ h => stretch_posX h)
    (((Small.const _ 2).mul (Small.self entryX)).sub (Q:=fun _ => 1)) a b
  refine ⟨o,s,a,b,⟨c,fun n hn => ?_⟩,fun n hn => (ho n hn).result⟩
  obtain ⟨hu,hA,hB,hR⟩ := hc n hn
  have H := ho n hn
  have HH := receipt_bound _ (stretch_posX hn)
  have he := H.result
  refine ⟨hu,H.bound.trans hA,H.valid,he.symm ▸ HH.1,he.symm ▸ ?_,he.symm ▸ hR,fun x y => ?_⟩
  · exact HH.2.trans_le (by unfold stretchX; omega)
  dsimp only
  rw [he]
  have hj := hs n hn x y
  exact ⟨hj.valid,hj.bound.trans hB,add_le_add (add_le_add_left H.time 1) hj.time,hj.result⟩

